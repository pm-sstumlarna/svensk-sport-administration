    "/activities/{activityId}/invitations": {
      "post": {
        "summary": "Send invitations",
        "description": "Sends invitations to a specific activity (FK2.4).",
        "tags": [
          "Activity and Planning"
        ],
        "parameters": [
          {
            "name": "activityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Invitations sent"
          }
        }
      }
    },
    "/activities/{activityId}/invitations/{naturalPersonId}": {
      "patch": {
        "summary": "Respond to invitation",
        "description": "Allows a person to respond to an activity invitation (FK2.4).",
        "tags": [
          "Activity and Planning"
        ],
        "parameters": [
          {
            "name": "activityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "naturalPersonId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": {
                      "anyOf": [
                        "Pending",
                        "Accepted",
                        "Declined"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Response recorded"
          }
        }
      }
    },
