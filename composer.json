{
    "name": "situ/svensk-sport-administration",
    "description": "Ett administrationssystem for Svenska Sportklubbar.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Peter Myllykoski",
            "email": "peter.myllykoski@sstumlarna.se",
            "role": "Projektledare, Systemarkitekt, Utvecklare, Testare"
        }
    ],
    "require": {
        "php": "^8.4 || ^8.5",
        "ext-pdo": "*",
        "ext-pcntl": "*",
        "nyholm/psr7": "^1.5",
        "nyholm/psr7-server": "^1.0",
        "php-di/php-di": "^7.1.1",
        "psr/http-message": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "react/http": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "SSA\\": ["src/", "include/"]
        }
    },
    "require-dev": {
            "phpunit/phpunit": "^12.5.4"
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\SSA\\": "test/"
        }
    },
    "scripts": {
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "DEVELOPMENT=true php main.php"
        ],
        "stage": [
            "Composer\\Config::disableProcessTimeout",
            "STAGE=true php main.php"
        ],
        "prod": [
            "Composer\\Config::disableProcessTimeout",
            "PRODUCTION=true php main.php"
        ],
        "test": "vendor/bin/phpunit"
    }
}